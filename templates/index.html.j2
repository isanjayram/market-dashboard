<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#0d0d0d">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
<link rel="icon" href="/icon-192.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Brief">
<title>Morning Brief · {{ today_label }}</title>
<script>
try { if (localStorage.getItem("theme") === "light") document.documentElement.dataset.theme = "light"; } catch (e) {}
(function () { var t = (location.hash || "").slice(1); if (!/^(brief|market|rent|villas|news|more)$/.test(t)) t = "brief"; document.documentElement.dataset.tab = t; })();
</script>
<style>{{ css|safe }}</style>
</head>
<body>
{%- set k = pulse.kpi if pulse else none %}
{%- set c = pulse.compare if pulse else none %}
<header class="top">
  <div>
    <h1>Good morning, Sanjay</h1>
    <p class="sub">{{ today_label }} · updated {{ updated }}</p>
    {%- if meta.stale %}<span class="status warn"><i></i>{{ meta.stale_short }}</span>
    {%- else %}<span class="status"><i></i>Up to date{% if pulse %} · DLD {{ pulse.as_of|day_label('%a %-d %b') }}{% endif %}</span>{% endif %}
  </div>
  <button id="theme" class="icon-btn" type="button" aria-label="Switch between dark and light mode">
    <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
    <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
</header>

<main>
{%- if meta.test %}<div class="stale" role="alert">TEST RUN: built from local files. Don't quote these numbers.</div>{% endif %}
{%- if meta.stale %}<div class="stale" role="alert">⚠ STALE: {{ meta.stale_reason }}</div>{% endif %}

{# ============================== BRIEF ============================== #}
<section class="tab" id="brief" aria-label="Morning brief">
  <div class="card">
    <h2>Morning brief <small>{{ brief.mode|brief_mode }}</small></h2>
    <ul class="brief">{% for b in brief.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
  </div>
  {%- if brief.talking_points %}
  <div class="card">
    <h2>Say this on calls <small>tap to copy</small></h2>
    {%- for t in brief.talking_points %}
    <button class="say" type="button" data-copy="{{ t }}"><span class="num">{{ loop.index }}</span><span class="t">{{ t }}</span><span class="copy">Copy</span></button>
    {%- endfor %}
  </div>
  {%- endif %}
  {%- if listings %}
  <div class="card" id="top10">
    <h2>Your Top 10 <small>checked {{ listings.checked_at|ago }}</small></h2>
    {%- if listings.changed %}
    <p class="t10-lead">{{ listings.changed|length }} fact{{ 's' if listings.changed|length > 1 }} on your site no longer match{{ 'es' if listings.changed|length == 1 }} the developer's page:</p>
    {%- for c in listings.changed %}
    <a class="mini-news" href="{{ c.url }}" target="_blank" rel="noopener">
      <span class="imp high" aria-hidden="true"></span>
      <span><b>{{ c.project }} · {{ c.label }}</b><small>Your site: {{ c.expect }} → developer now: {{ c.found }}</small></span>
    </a>
    {%- endfor %}
    <p class="empty">Tell Claude "update the Top 10" and the site is fixed in a minute.</p>
    {%- else %}
    <p class="t10-ok"><span class="pill up">✓ All {{ listings.counts.ok }} checks match</span> Prices and facts on your site agree with the developers' pages.</p>
    {%- endif %}
    {%- if listings.news %}
    <h3 class="t10-h">In the news, last 14 days</h3>
    {%- for n in listings.news %}
    <a class="mini-news" href="{{ n.link }}" target="_blank" rel="noopener">
      <span class="imp medium" aria-hidden="true"></span>
      <span><b>{{ n.title }}</b><small>{{ n.project }} · {{ n.source }} · {{ n.published|ago }}</small></span>
    </a>
    {%- endfor %}
    {%- endif %}
    {%- if listings.problems or listings.unchecked %}
    <details>
      <summary>{% if listings.problems %}{{ listings.problems|length }} couldn't be checked{% else %}What isn't checked{% endif %}</summary>
      <ul class="t10-list">
        {%- for x in listings.problems %}<li><a href="{{ x.url }}" target="_blank" rel="noopener">{{ x.project }} · {{ x.label }}</a>: {{ x.note }}</li>{% endfor %}
        {%- if listings.unchecked %}<li>News only (no price on the developer's page): {{ listings.unchecked|join(', ') }}</li>{% endif %}
      </ul>
    </details>
    {%- endif %}
    <a class="more-link" href="{{ listings.site }}/#projects" target="_blank" rel="noopener">Open your Top 10 →</a>
  </div>
  {%- endif %}
  {%- if news and news.top %}
  <div class="card">
    <h2>Top news <a class="more-link" href="#news" data-go="news">All news →</a></h2>
    {%- for n in news.top[:3] %}
    <a class="mini-news" href="{{ n.link }}" target="_blank" rel="noopener">
      <span class="imp {{ n.impact|lower }}" aria-label="{{ n.impact }} impact"></span>
      <span><b>{{ n.headline }}</b><small>{{ n.impact }} · {{ n.source }} · {{ n.published|ago }}</small></span>
    </a>
    {%- endfor %}
  </div>
  {%- endif %}
  {%- if pulse %}
  <a class="kpis" href="#market" data-go="market">
    <span><small>Sales · {{ pulse.as_of|day_label('%a') }}</small><b>{{ k.deals|num }}</b></span>
    <span><small>Median /sqft</small><b>{{ k.median_psf|num }}</b></span>
    <span><small>Off-plan</small><b>{{ k.offplan_share|round|int }}%</b></span>
  </a>
  {%- endif %}
</section>

{# ============================== MARKET ============================== #}
<section class="tab" id="market" aria-label="Market pulse">
{%- if pulse %}
  <div class="card hero">
    <div class="eyebrow">DLD sales · {{ pulse.as_of|day_label }}</div>
    <div class="hero-n">{{ k.deals|num }}<em>sales</em></div>
    {%- set wd = c.deals.wd|delta %}
    <div class="hero-sub"><span class="v">{{ k.value|aed }}</span><span class="pill {{ wd.cls }}">{{ wd.text }} vs a typical {{ c.weekday }}</span></div>
    <div class="cmp">
      {%- set d7 = c.deals.d7|delta %}{%- set a = c.deals.d30|delta %}{%- set y = c.deals.yoy|delta %}
      <div><small>7-day avg</small><b>{{ c.deals.avg7|num }}</b><span class="{{ d7.cls }}">{{ d7.text }}</span></div>
      <div><small>30-day avg</small><b>{{ c.deals.avg30|num }}</b><span class="{{ a.cls }}">{{ a.text }}</span></div>
      <div><small>Same week {{ pulse.as_of[:4]|int - 1 }}</small><b>{{ c.deals.ly_avg|num }}<span class="muted unit">/day</span></b><span class="{{ y.cls }}">{{ y.text }}</span></div>
    </div>
  </div>
  <div class="tiles">
    <div class="card">
      <small>Off-plan share</small>
      <div class="v">{{ k.offplan_share|round|int }}%</div>
      <div class="split" aria-hidden="true"><span style="flex:{{ k.offplan }}"></span><span style="flex:{{ k.ready }}"></span></div>
      <div class="lg"><span class="nb"><i class="sw off"></i>{{ k.offplan|num }} off-plan</span> · <span class="nb"><i class="sw ready"></i>{{ k.ready|num }} ready</span></div>
    </div>
    <div class="card">
      <small>Median price · homes</small>
      <div class="v">{{ k.median_psf|num }} <em>AED/sqft</em></div>
      {%- set p = c.psf.d30|delta %}
      <div class="row"><span class="pill {{ p.cls }}">{{ p.text }} 30d</span>{{ spark_psf|safe }}</div>
      <div class="lg">Average {{ k.avg_psf|num }}</div>
    </div>
  </div>
  <div class="card">
    <h2>Trend
      <span class="seg" data-range-group="trend" role="group" aria-label="Chart">
        <button type="button" data-range="sales" aria-pressed="true">Sales</button><button type="button" data-range="psf" aria-pressed="false">Price</button>
      </span>
    </h2>
    <div data-group="trend" data-panel="sales">
      <div class="seg sub" data-range-group="range" role="group" aria-label="Range">
        <button type="button" data-range="d30" aria-pressed="false">30D</button><button type="button" data-range="d90" aria-pressed="true">90D</button><button type="button" data-range="m12" aria-pressed="false">12M</button>
      </div>
      <div data-group="range" data-panel="d30" hidden>{{ charts.d30|safe }}</div>
      <div data-group="range" data-panel="d90">{{ charts.d90|safe }}</div>
      <div data-group="range" data-panel="m12" hidden>{{ charts.m12|safe }}</div>
      <p class="foot">Sales per business day, 7-day average.</p>
    </div>
    <div data-group="trend" data-panel="psf" hidden>{{ charts.psf|safe }}<p class="foot">Median AED/sqft for homes, weekly, 12 months.</p></div>
  </div>
  <div class="card">
    <h2>Top areas · 7 days
      <span class="seg" data-range-group="top" role="group" aria-label="Rank by">
        <button type="button" data-range="vol" aria-pressed="true">Sales</button><button type="button" data-range="val" aria-pressed="false">Value</button>
      </span>
    </h2>
    <div data-group="top" data-panel="vol">{{ charts.top_volume|safe }}</div>
    <div data-group="top" data-panel="val" hidden>{{ charts.top_value|safe }}</div>
  </div>
  <div class="card" id="watchlist">
    <h2>Watchlist <small>30 days · median AED/sqft</small></h2>
    {%- macro wrow(w) %}
      {%- set w30 = w.d30|delta %}{%- set w90 = w.d90|delta %}
      <div class="wrow">
        <div><b>{{ w.name }}</b><small>{% if w.deals30 %}<span class="nb">{{ w.deals30|num }} sales</span>{% if w.offplan_share is not none %} · <span class="nb">{{ w.offplan_share }}% off-plan</span>{% endif %}{% else %}no sales in 30 days{% endif %}</small></div>
        <div class="r"><div>{{ w.median_psf|num if w.median_psf else '—' }}</div>
          <div class="pills"><span class="pill {{ w30.cls }}">30d {{ w30.text }}</span><span class="pill {{ w90.cls }}">90d {{ w90.text }}</span></div></div>
      </div>
    {%- endmacro %}
    {%- for w in pulse.watch[:6] %}{{ wrow(w) }}{% endfor %}
    {%- if pulse.watch|length > 6 %}
    <details><summary>Show {{ pulse.watch|length - 6 }} more</summary>{% for w in pulse.watch[6:] %}{{ wrow(w) }}{% endfor %}</details>
    {%- endif %}
    {%- if pulse.rising %}
    <div class="rising" aria-label="Rising fastest"><span class="lbl">Rising fastest · ready homes · 90d</span>{% for r in pulse.rising %}<span>{{ r.area }} <b>▲ {{ r.d90 }}%</b></span>{% endfor %}</div>
    {%- endif %}
  </div>
  <div class="card">
    <h2>Largest home sales <small>{{ pulse.as_of|day_label('%a %-d %b') }}</small></h2>
    {%- for d in pulse.largest[:3] %}
    <div class="deal"><b>{{ d.worth|aed }}</b><span class="d">{{ d.type }}, {{ d.reg }}<br>{{ d.project + ' · ' if d.project }}{{ d.area }}</span></div>
    {%- endfor %}
    {%- if pulse.largest_land %}<p class="foot">Largest land/building: {{ pulse.largest_land.worth|aed }}, {{ pulse.largest_land.area }}.</p>{% endif %}
  </div>
  <p class="src">Source: DLD via data.dubai, as of {{ pulse.as_of|day_label('%-d %b %Y') }}. "Typical {{ c.weekday }}" = last 4 {{ c.weekday }}s; averages use business days. n/a = fewer than {{ settings.pulse.min_sample }} sales.</p>
{%- else %}
  <div class="card"><h2>Market</h2><p class="empty">DLD data isn't available yet. The next run retries.</p></div>
{%- endif %}
</section>

{# ============================== RENT ============================== #}
<section class="tab" id="rent" aria-label="Rent monitor">
{%- if rent %}
  {%- if rent.alerts %}
  <div class="card">
    <h2>Rent moves over 5% <small>{{ rent.month }}</small></h2>
    {%- for a in rent.alerts %}{%- set m = a.mom|delta %}
    <div class="wrow"><div><b>{{ a.area }} · {{ a.label }}</b><small>{{ a.n }} new contracts</small></div><div class="r"><span class="pill {{ m.cls }}">{{ m.text }} MoM</span></div></div>
    {%- endfor %}
  </div>
  {%- endif %}
  <div class="card">
    <h2>Median rent <small>new contracts · {{ rent.month }}</small></h2>
    <div class="seg wide" data-range-group="kind" role="group" aria-label="Property type">
      {%- for k in rent.kinds %}<button type="button" data-range="k-{{ k.key }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ k.label }}</button>{% endfor %}
    </div>
    {%- for k in rent.kinds %}
    <div data-group="kind" data-panel="k-{{ k.key }}"{% if not loop.first %} hidden{% endif %}>
      {%- if k.beds %}
      {%- set first = '1br' if '1br' in k.beds else k.beds[0] %}
      <div class="seg" data-range-group="beds-{{ k.key }}" role="group" aria-label="Bedrooms">
        {%- for b in k.beds %}<button type="button" data-range="b-{{ k.key }}-{{ b }}" aria-pressed="{{ 'true' if b == first else 'false' }}">{{ rent.bed_labels[b] }}</button>{% endfor %}
      </div>
      {%- for b in k.beds %}
      <div data-group="beds-{{ k.key }}" data-panel="b-{{ k.key }}-{{ b }}"{% if b != first %} hidden{% endif %}>
        {%- for r in rent.rows if r.kind == k.key and r.beds == b %}{%- set m = r.mom|delta %}{%- set y = r.yoy|delta %}
        <div class="wrow"><div><b>{{ r.area }}</b><small><span class="nb">{{ r.n }} contracts</span>{% if r.gross_yield %} · <span class="nb">gross yield {{ r.gross_yield }}%</span>{% endif %}</small></div>
          <div class="r"><div>AED {{ r.median|num }}</div><div class="pills"><span class="pill {{ m.cls }}">MoM {{ m.text }}</span><span class="pill {{ y.cls }}">YoY {{ y.text }}</span></div></div></div>
        {%- endfor %}
      </div>
      {%- endfor %}
      {%- else %}<p class="empty">Not enough new contracts in the watchlist areas last month.</p>{%- endif %}
    </div>
    {%- endfor %}
    <p class="foot">Only areas with at least 20 new contracts in the month are shown. Apartments: your watchlist areas. Villas &amp; townhouses: the 12 busiest communities in Dubai. DLD's rent records file townhouses as "Villa", so the two can't be separated; as a rough guide, 2–3BR is mostly townhouses and 4–5BR mostly villas. Gross yield (apartments only) = median annual rent ÷ median sale price for the same area and size, before costs.</p>
  </div>
  <p class="src">Source: DLD Ejari rent contracts via data.dubai. Renewals excluded (they lag the market because of the rent cap).</p>
{%- else %}
  <div class="card"><h2>Rent monitor</h2>
    <p class="empty">Rent numbers appear once DLD's rent contracts are loaded. That needs a one-time download on your Mac, then the data.dubai API key for daily updates.</p></div>
{%- endif %}
</section>

{# ============================== VILLAS ============================== #}
{%- macro stats(items) %}
  {%- for s in items %}
  <div class="wrow"><div><b class="vf-n">{{ s.value }}{% if s.unit %}<span class="unit"> {{ s.unit }}</span>{% endif %}</b><small>{{ s.label }}</small></div><div class="r small muted">{{ s.src }}</div></div>
  {%- endfor %}
{%- endmacro %}
<section class="tab" id="villas" aria-label="Villa and townhouse market facts">
{%- if villa %}
  <div class="card hero">
    <div class="eyebrow">Villas and townhouses · {{ villa.dldWindow }}</div>
    <div class="hero-n">{{ villa.hero[0].value }}<em>Dubai sales</em></div>
    <div class="hero-sub"><span class="v">AED {{ villa.hero[1].value }}{{ villa.hero[1].unit }}</span><span class="pill flat">paid in Dubai, 12 months</span></div>
    <div class="cmp vf-cmp">
      <div><small>Abu Dhabi sales, H1 2026</small><b>{{ villa.hero[2].value }}</b></div>
      <div><small>Paid in Abu Dhabi</small><b>AED {{ villa.hero[3].value }}{{ villa.hero[3].unit }}</b></div>
    </div>
    <p class="foot">Reference figures, checked {{ villa.asOf }}. They do not update each morning.</p>
  </div>

  <div class="card">
    <h2>Sales by month <small>Dubai</small></h2>
    {{ villa.charts.monthly|safe }}
    <p class="small">{{ villa.supplyDemand.trend }}</p>
  </div>
  <div class="card">
    <h2>What sells <small>Dubai, 12 months</small></h2>
    <div class="seg wide" data-range-group="vf-sell" role="group" aria-label="Split by">
      <button type="button" data-range="vf-beds" aria-pressed="true">By bedrooms</button><button type="button" data-range="vf-prices" aria-pressed="false">By price</button>
    </div>
    <div data-group="vf-sell" data-panel="vf-beds">{{ villa.charts.beds|safe }}</div>
    <div data-group="vf-sell" data-panel="vf-prices" hidden>{{ villa.charts.prices|safe }}</div>
    <p class="foot">{{ villa.supplyDemand.gap }}</p>
  </div>
  <div class="card">
    <h2>Villas against townhouses <small>Abu Dhabi</small></h2>
    {{ stats(villa.supplyDemand.villa) }}{{ stats(villa.supplyDemand.townhouse) }}
  </div>

  <div class="card">
    <h2>Busiest communities <small>sales, 12 months</small></h2>
    {{ villa.charts.busiest|safe }}
    {{ stats(villa.communities.dubai) }}{{ stats(villa.communities.abuDhabi) }}
    <p class="foot">{{ villa.communities.gap }}</p>
  </div>
  <div class="card">
    <h2>Price growth <small>ready villas, by community</small></h2>
    {{ villa.charts.growth|safe }}
    <p class="small">{{ villa.growth.dubaiNote }}</p>
    {{ stats(villa.growth.others) }}
    <p class="foot">{{ villa.growth.caveat }} {{ villa.growth.abuDhabiGap }}</p>
  </div>

  <div class="card">
    <h2>Built or building <small>Dubai</small></h2>
    {{ stats(villa.build.dubai) }}
    <div class="split" aria-hidden="true"><span style="flex:{{ villa.build.dubaiSplit.offPlan }}"></span><span style="flex:{{ villa.build.dubaiSplit.ready }}"></span></div>
    <div class="lg"><i class="sw off"></i>{{ villa.build.dubaiSplit.offPlan|num }} off-plan sales · <i class="sw ready"></i>{{ villa.build.dubaiSplit.ready|num }} ready, last 12 months</div>
  </div>
  <div class="card">
    <h2>Built or building <small>Abu Dhabi</small></h2>
    {{ stats(villa.build.abuDhabi) }}
    <p class="foot">{{ villa.build.gap }}</p>
  </div>

  <div class="card">
    <h2>Who can own <small>{{ villa.tenure.total }} Dubai villas on the register</small></h2>
    {%- for c in villa.tenure.counts %}
    <div class="wrow"><div><b>{{ c.label }} · {{ c.pct }}%</b><small>{{ c.text }}</small></div><div class="r"><b class="num">{{ c.value }}</b></div></div>
    {%- endfor %}
    <div class="seg wide" data-range-group="vf-ten" role="group" aria-label="Area list">
      <button type="button" data-range="vf-free" aria-pressed="true">Freehold</button><button type="button" data-range="vf-lease" aria-pressed="false">Leasehold</button><button type="button" data-range="vf-cit" aria-pressed="false">Citizens</button>
    </div>
    <div data-group="vf-ten" data-panel="vf-free">{{ villa.charts.freehold|safe }}</div>
    <div data-group="vf-ten" data-panel="vf-lease" hidden>{{ villa.charts.leasehold|safe }}</div>
    <div data-group="vf-ten" data-panel="vf-cit" hidden>{{ villa.charts.citizens|safe }}</div>
    {{ stats([villa.tenure.zones]) }}
    {%- for r in villa.tenure.rows %}
    <details class="dev"><summary><b>{{ r.place }}: the rules</b></summary>
      <p class="small"><b>Freehold.</b> {{ r.freehold }}</p><p class="small"><b>Leasehold.</b> {{ r.leasehold }}</p>
      {%- if r.law %}<p class="small muted">{{ r.law }}</p>{% endif %}
    </details>
    {%- endfor %}
    <p class="foot">{{ villa.tenure.caveat }} {{ villa.tenure.abuDhabiGap }}</p>
  </div>

  <div class="card">
    <h2>Developers <small>Dubai villa sales, 12 months</small></h2>
    <div class="seg wide" data-range-group="vf-dev" role="group" aria-label="Rank by">
      <button type="button" data-range="vf-sold" aria-pressed="true">Most sold</button><button type="button" data-range="vf-pricey" aria-pressed="false">Highest price</button>
    </div>
    <div data-group="vf-dev" data-panel="vf-sold">{{ villa.charts.sold|safe }}<p class="small">{{ villa.developers.soldNote }} {{ villa.developers.soldCaveat }}</p></div>
    <div data-group="vf-dev" data-panel="vf-pricey" hidden>{{ villa.charts.pricey|safe }}<p class="small">{{ villa.developers.priceyNote }}</p></div>
    {{ stats(villa.developers.abuDhabi) }}
    <p class="foot">{{ villa.developers.abuDhabiGap }}</p>
  </div>

  <div class="card">
    <h2>Beachfront <small>villas with a known count</small></h2>
    {%- for r in villa.beach.rows %}
    <div class="wrow"><div><b>{{ r.name }}</b><small>{{ r.where }} · {{ r.note }}</small></div><div class="r"><b class="num">{{ r.count }}</b><br><span class="small muted">{{ r.src }}</span></div></div>
    {%- endfor %}
    <p class="foot">{{ villa.beach.gap }} {{ villa.beach.more }}</p>
  </div>

  <h2 class="sec">The Palms</h2>
  {%- for p in villa.palms %}
  <details class="card lm"><summary><b>{{ p.name }}</b><small>{{ p.tag }}</small></summary>
    {%- for f in p.facts %}
    <div class="wrow"><div><small>{{ f[0] }}</small></div><div class="r small"><b>{{ f[1] }}</b> <span class="muted">{{ f[2] }}</span></div></div>
    {%- endfor %}
    {%- if p.note %}<p class="small">{{ p.note }}</p>{% endif %}
  </details>
  {%- endfor %}

  <h2 class="sec">Top 20 by sales</h2>
  <div class="card">
    {%- for p in villa.top20 %}
    <details class="dev"><summary><span class="rank">{{ loop.index }}</span><b>{{ p.name }}</b><span class="r">{{ p.sales }}</span></summary>
      <p class="small muted">{{ p.dev }} · {{ p.where }}</p>
      <div class="wrow"><div><small>Money paid</small></div><div class="r small"><b>{{ p.value }}</b></div></div>
      <div class="wrow"><div><small>Median price</small></div><div class="r small"><b>{{ p.median }}</b> · {{ p.ppsf }} per sq ft</div></div>
      <div class="wrow"><div><small>Off-plan share</small></div><div class="r small"><b>{{ p.offPlan }}</b></div></div>
      <div class="wrow"><div><small>Bedrooms · homes</small></div><div class="r small"><b>{{ p.beds }}</b> · {{ p.homes }}</div></div>
      {%- if p.note %}<p class="small">{{ p.note }}</p>{% endif %}
    </details>
    {%- endfor %}
    <p class="foot">{{ villa.top20Note }}</p>
  </div>

  <h2 class="sec">One of a kind</h2>
  <div class="card">
    {%- for r in villa.unique.rows %}
    <div class="wrow"><div><b>{{ r.name }}</b><small>{{ r.where }} · {{ r.note }}</small></div><div class="r small"><b>{{ r.figure }}</b><br><span class="muted">{{ r.src }}</span></div></div>
    {%- endfor %}
    <p class="foot">{{ villa.unique.gap }}</p>
  </div>

  <h2 class="sec">Villa terms, A to Z</h2>
  <div class="card">
    {%- for g in villa.guide %}
    <details class="dev"><summary><b>{{ g.term }}</b></summary><p class="small">{{ g.text }}</p></details>
    {%- endfor %}
  </div>

  <div class="card">
    <h2>Sources</h2>
    {%- for s in villa.sources %}
    <p class="small"><b>{{ s.name }}.</b> {{ s.what }}{% if s.url %} <a href="{{ s.url }}" target="_blank" rel="noopener">Open ↗</a>{% endif %}</p>
    {%- endfor %}
  </div>
{%- else %}<div class="card"><p class="empty">Villa facts file is missing.</p></div>{% endif %}
</section>

{# ============================== NEWS ============================== #}
<section class="tab" id="news" aria-label="Market-impact news">
{%- if news %}
  <p class="src top">{{ news.top|length }} top items from the last {{ news.window_hours }} hours · {{ news.count_relevant }} market stories out of {{ news.count_fetched }} read.</p>
  {%- for n in news.top %}
  <article class="card news">
    <div class="meta"><span class="badge"><i class="imp {{ n.impact|lower }}"></i>{{ n.impact }}</span><span class="badge">{{ n.category }}</span>{% if n.watch %}<span class="badge wl">★ Watchlist</span>{% endif %}</div>
    <h3>{{ n.headline }}</h3>
    {%- if n.summary %}<p>{{ n.summary }}</p>{% endif %}
    <div class="why"><b>Why it matters for buyers/agents:</b> {{ n.why }}</div>
    <div class="reason">{{ n.impact }} impact: {{ n.impact_reason }}</div>
    <div class="src2"><span>{{ n.source }} · {{ n.published|ago }}{% if n.also %} · also {{ n.also|join(', ') }}{% endif %}{% if n.more %} · +{{ n.more }} more on this{% endif %}</span><a href="{{ n.link }}" target="_blank" rel="noopener">Read ↗</a></div>
  </article>
  {%- else %}
  <div class="card"><p class="empty">No market-moving stories in the last {{ news.window_hours }} hours.</p></div>
  {%- endfor %}
  <div class="card" id="archive">
    <h2>Archive <small>30 days</small></h2>
    <input id="q" type="search" placeholder="Search headlines" aria-label="Search the news archive">
    <div class="chips-f" id="catf">
      <button type="button" aria-pressed="true" data-cat="">All</button>{% for cat in news_categories %}<button type="button" aria-pressed="false" data-cat="{{ cat }}">{{ cat }}</button>{% endfor %}
    </div>
    <div id="arch-list"><p class="empty">Loading…</p></div>
  </div>
  <p class="src">Sources: {{ news_sources|join(', ') }}. Headlines link to the original; summaries are written in our own words ({{ news.mode }}).</p>
{%- else %}
  <div class="card"><p class="empty">News isn't available right now. The next run retries.</p></div>
{%- endif %}
</section>

{# ============================== MORE ============================== #}
<section class="tab" id="more" aria-label="Pipeline, developers and landmarks">
  <div class="chips-f jump"><a href="#pipeline-h" class="chip">Pipeline</a><a href="#dev-h" class="chip">Developers</a><a href="#lm-h" class="chip">Landmarks</a></div>

  <h2 class="sec" id="pipeline-h">Project pipeline</h2>
  {%- if pipeline and pipeline['items'] %}
  <div class="chips-f" id="pipef">
    <button type="button" aria-pressed="true" data-f="all">All</button><button type="button" aria-pressed="false" data-f="Dubai">Dubai</button><button type="button" aria-pressed="false" data-f="Sharjah">Sharjah</button><button type="button" aria-pressed="false" data-f="Off-plan launch">Off-plan</button><button type="button" aria-pressed="false" data-f="Infrastructure">Infrastructure</button>
  </div>
  {%- for e in pipeline['items'] %}
  <article class="card pipe" data-region="{{ e.region }}" data-kind="{{ e.kind }}">
    <div class="meta">{% if e.new %}<span class="badge new">NEW</span>{% endif %}<span class="badge">{{ e.kind }}</span><span class="badge">{{ e.region }}</span></div>
    <h3>{{ e.title }}</h3>
    {%- set f = e.fields %}
    {%- if f.project or f.developer or f.starting_price or f.handover or f.payment_plan %}
    <dl class="facts">
      {%- for key, label in [('project','Project'),('developer','Developer'),('location','Location'),('type','Type'),('launch_date','Launch'),('handover','Handover'),('starting_price','From'),('payment_plan','Payment plan')] %}
      {%- if f[key] %}<dt>{{ label }}</dt><dd>{{ f[key] }}</dd>{% endif %}
      {%- endfor %}
    </dl>
    {%- else %}<p class="muted small">Details pending: they'll be filled in once the AI key is set.</p>{% endif %}
    {%- if e.catalyst %}<div class="why"><b>Analysis, not a forecast:</b> near {{ e.catalyst.name }} ({{ e.catalyst.status }}). <a href="{{ e.catalyst.url }}" target="_blank" rel="noopener">{{ e.catalyst.source }} ↗</a></div>{% endif %}
    <div class="src2"><span>{{ e.source }} · first seen {{ e.first_seen|day_label('%-d %b') }}</span><a href="{{ e.link }}" target="_blank" rel="noopener">Read ↗</a></div>
  </article>
  {%- endfor %}
  {%- else %}<div class="card"><p class="empty">No launches or infrastructure announcements picked up yet.</p></div>{% endif %}

  <h2 class="sec" id="dev-h">Developers</h2>
  <div class="card">
    <h2>Dubai top 5 <small>off-plan sales, 12 months</small></h2>
    {%- if developers and developers.dubai %}
    {%- for d in developers.dubai %}
    <details class="dev"><summary><span class="rank">{{ loop.index }}</span><b>{{ d.name }}</b><span class="r">{{ d.value_12m|aed }}</span></summary>
      <p class="small muted">{{ d.offplan_deals_12m|num }} off-plan sales in 12 months.</p>
      {%- for p in d.top_projects %}
      <div class="wrow"><div><b>{{ p.project }}</b><small>{{ p.sales_12m|num }} sales · {{ p.area }}</small></div><div class="r small">off-plan {{ p.offplan_psf|num if p.offplan_psf else 'n/a' }}<br>resale {{ p.resale_psf|num if p.resale_psf else 'n/a' }} /sqft</div></div>
      {%- endfor %}
      {%- if d.recent_launches %}<p class="small">Registered with DLD in the last year: {% for l in d.recent_launches %}{{ l.project }} ({{ l.area }}){{ ', ' if not loop.last }}{% endfor %}.</p>{% endif %}
    </details>
    {%- endfor %}
    <p class="foot">Source: DLD sales via data.dubai, matched to developers with DLD's projects list of {{ developers.projects_as_of }}. Projects registered after that date aren't counted yet.</p>
    {%- else %}<p class="empty">Needs DLD's projects list (a small one-time download) to match sales to developers.</p>{% endif %}
  </div>
  <div class="card">
    <h2>Sharjah top 5 <small>resale data not public</small></h2>
    {%- for d in developers.sharjah %}
    <div class="wrow"><div><b>{{ d.name }}</b><small>{{ d.flagships|join(', ') if d.flagships else 'Flagships not listed' }}</small>
      {%- for n in d.news %}<a class="small link" href="{{ n.link }}" target="_blank" rel="noopener">{{ n.headline }} ↗</a>{% endfor %}</div>
      <div class="r small muted">N/A</div></div>
    {%- endfor %}
  </div>

  <h2 class="sec" id="lm-h">Landmarks</h2>
  {%- if landmarks %}
  {%- for l in landmarks %}
  <details class="card lm"><summary><b>{{ l.name }}</b><small>{{ l.emirate }}{% if l.opened %} · {{ l.opened }}{% endif %}</small></summary>
    <ul>{% for b in l.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
    <p class="small"><b>Area price:</b> {% if l.psf_now %}AED {{ l.psf_now|num }}/sqft now (DLD median for homes, 12 months, {{ l.price_label }}){% else %}no reliable data{% endif %}; at launch: {{ l.psf_launch or 'no reliable data' }}.</p>
    <p class="small muted">{% for s in l.sources %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.label }} ↗</a>{{ ' · ' if not loop.last }}{% endfor %}</p>
  </details>
  {%- endfor %}
  {%- else %}<div class="card"><p class="empty">Landmarks library coming in the next update.</p></div>{% endif %}
</section>
</main>

<footer>Built {{ now.strftime('%-d %b %Y, %H:%M') }} Gulf time · AI calls today {{ run.llm_calls }}/{{ run.llm_cap }} · Forecasts are never shown as fact.{% if meta.note %}<br>{{ meta.note }}{% endif %}</footer>

<nav class="tabbar" aria-label="Sections">
  <a href="#brief" data-go="brief"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h10M4 18h13"/></svg>Brief</a>
  <a href="#market" data-go="market"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19l5-6 4 3 7-9"/></svg>Market</a>
  <a href="#rent" data-go="rent"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11l8-6 8 6v8H4z"/><path d="M10 19v-5h4v5"/></svg>Rent</a>
  <a href="#villas" data-go="villas"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20V10l6-4 6 4v10"/><path d="M15 13l6 3v4H3"/><path d="M8 20v-5h2v5"/></svg>Villas</a>
  <a href="#news" data-go="news"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 9h8M8 13h8M8 16h5"/></svg>News</a>
  <a href="#more" data-go="more"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><circle cx="6" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="18" cy="12" r="1.8"/></svg>More</a>
</nav>
<script>{{ js|safe }}</script>
</body>
</html>

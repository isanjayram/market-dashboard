<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#0d0d0d">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="icon" href="/icon-192.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Brief">
<title>Morning Brief · {{ today_label }}</title>
<script>try { if (localStorage.getItem("theme") === "light") document.documentElement.dataset.theme = "light"; } catch (e) {}</script>
<style>{{ css|safe }}</style>
</head>
<body>
{%- set k = pulse.kpi if pulse else none %}
<header class="top">
  <div>
    <h1>Good morning, Sanjay</h1>
    <p class="sub">{{ today_label }} · updated {{ updated }}</p>
    {%- if meta.stale %}
    <span class="status warn"><i></i>{{ meta.stale_short }}</span>
    {%- else %}
    <span class="status"><i></i>All sources OK · AI {{ run.llm_calls }}/{{ run.llm_cap }}</span>
    {%- endif %}
  </div>
  <button id="theme" class="icon-btn" type="button" aria-label="Switch between dark and light mode">
    <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
    <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
</header>
<nav class="chips" aria-label="Sections">
  <a href="#market" class="on">Market</a><a href="#watchlist">Watchlist</a><a href="#next">Brief</a><a href="#next">News</a><a href="#next">Rent</a><a href="#next">Pipeline</a><a href="#next">Developers</a><a href="#next">Landmarks</a>
</nav>
<main>
{%- if meta.test %}
  <div class="stale" role="alert">TEST RUN: built from local files, not today's DLD download. Don't quote these numbers.</div>
{%- endif %}
{%- if meta.stale %}
  <div class="stale" role="alert">⚠ STALE: {{ meta.stale_reason }}</div>
{%- endif %}
{%- if pulse %}
{%- set c = pulse.compare %}
  <section id="market" aria-label="Market pulse">
    <div class="card hero">
      <div class="eyebrow">DLD sales · {{ pulse.as_of|day_label }}{% if pulse.partial_day %} · {{ pulse.partial_day.deals|num }} more so far on {{ pulse.partial_day.day|day_label('%a %-d') }} (partial){% endif %}</div>
      <div class="hero-n">{{ k.deals|num }}<em>deals</em></div>
      {%- set d7 = c.deals.d7|delta %}{%- set wd = c.deals.wd|delta %}
      <div class="hero-sub"><span class="v">{{ k.value|aed }}</span><span class="pill {{ wd.cls }}">{{ wd.text }} vs a typical {{ c.weekday }}</span></div>
      <div class="cmp">
        {%- set a = c.deals.d30|delta %}{%- set y = c.deals.yoy|delta %}
        <div><small>7-day avg</small><b>{{ c.deals.avg7|num }}</b><span class="{{ d7.cls }}">{{ d7.text }}</span></div>
        <div><small>30-day avg</small><b>{{ c.deals.avg30|num }}</b><span class="{{ a.cls }}">{{ a.text }}</span></div>
        <div><small>Same week {{ pulse.as_of[:4]|int - 1 }}</small><b>{{ c.deals.ly_avg|num }}<span class="muted" style="display:inline;font-weight:500">/day</span></b><span class="{{ y.cls }}">{{ y.text }}</span></div>
      </div>
      <p class="foot">Source: DLD via data.dubai · as of {{ pulse.as_of|day_label('%-d %b %Y') }}. DLD's open data runs a few days behind. "Typical {{ c.weekday }}" = average of the last 4 {{ c.weekday }}s; other averages use business days only.</p>
    </div>

    <div class="tiles">
      <div class="card">
        <small>Off-plan share</small>
        <div class="v">{{ k.offplan_share|round|int }}%</div>
        <div class="split" aria-hidden="true"><span style="flex:{{ k.offplan }}"></span><span style="flex:{{ k.ready }}"></span></div>
        <div class="lg"><i class="sw off"></i>{{ k.offplan|num }} off-plan<br><i class="sw ready"></i>{{ k.ready|num }} ready</div>
      </div>
      <div class="card">
        <small>Median price · homes</small>
        <div class="v">{{ k.median_psf|num }} <em>AED/sqft</em></div>
        {%- set p = c.psf.d30|delta %}
        <div class="row"><span class="pill {{ p.cls }}">{{ p.text }} 30d</span>{{ spark_psf|safe }}</div>
        <div class="lg">Average {{ k.avg_psf|num }} AED/sqft</div>
      </div>
      <div class="card">
        <small>Value</small>
        <div class="v">{{ k.value|aed }}</div>
        {%- set v = c.value.d7|delta %}
        <div class="row"><span class="pill {{ v.cls }}">{{ v.text }} 7d</span>{{ spark_value|safe }}</div>
      </div>
      <div class="card">
        <small>What sold</small>
        <div class="v">{{ k.residential|num }} <em>homes</em></div>
        <div class="lg">{{ k.land|num }} land · {{ k.buildings|num }} buildings<br>Off-plan share, 7 days: {{ c.offplan_share_7d if c.offplan_share_7d is not none else 'n/a' }}%</div>
      </div>
    </div>

    <div class="card">
      <h2>Deals trend
        <span class="seg" data-range-group role="group" aria-label="Range">
          <button type="button" data-range="d30" aria-pressed="false">30D</button><button type="button" data-range="d90" aria-pressed="true">90D</button><button type="button" data-range="m12" aria-pressed="false">12M</button>
        </span>
      </h2>
      <div data-panel="d30" hidden>{{ charts.d30|safe }}</div>
      <div data-panel="d90">{{ charts.d90|safe }}</div>
      <div data-panel="m12" hidden>{{ charts.m12|safe }}</div>
      <p class="foot">Deals per business day, 7-day average. Source: DLD via data.dubai.</p>
    </div>

    {%- if charts.psf %}
    <div class="card">
      <h2>Price trend <small>median AED/sqft · homes · weekly</small></h2>
      {{ charts.psf|safe }}
      <p class="foot">Residential units and villas, weeks with 50+ sales. Source: DLD via data.dubai.</p>
    </div>
    {%- endif %}

    <div class="card">
      <h2>Top areas
        <span class="seg" data-range-group role="group" aria-label="Rank by">
          <button type="button" data-range="vol" aria-pressed="true">Deals</button><button type="button" data-range="val" aria-pressed="false">Value</button>
        </span>
      </h2>
      <div data-panel="vol">{{ charts.top_volume|safe }}</div>
      <div data-panel="val" hidden>{{ charts.top_value|safe }}</div>
      <p class="foot">Last 7 days to {{ pulse.as_of|day_label('%-d %b') }}. Areas are DLD communities, named after their main master project.</p>
    </div>

    <div class="card">
      <h2>Largest deals <small>homes · {{ pulse.as_of|day_label }}</small></h2>
      {%- for d in pulse.largest %}
      <div class="deal"><b>{{ d.worth|aed }}</b><span class="d">{{ d.type }}{% if d.sqft %}, {{ d.sqft|num }} sqft{% endif %}, {{ d.reg }}<br>{{ d.project + ' · ' if d.project }}{{ d.area }}</span></div>
      {%- else %}
      <p class="empty">No home sales recorded.</p>
      {%- endfor %}
      {%- if pulse.largest_land %}
      <p class="foot">Largest land/building deal: {{ pulse.largest_land.worth|aed }} ({{ pulse.largest_land.type|lower }}, {{ pulse.largest_land.area }}).</p>
      {%- endif %}
    </div>

    <div class="card" id="watchlist">
      <h2>Watchlist <small>last 30 days · median AED/sqft</small></h2>
      {%- for w in pulse.watch %}
      {%- set w30 = w.d30|delta %}{%- set w90 = w.d90|delta %}
      <div class="wrow">
        <div><b>{{ w.name }}</b><small>{% if w.deals30 %}{{ w.deals30|num }} deals{% if w.offplan_share is not none %} · {{ w.offplan_share }}% off-plan{% endif %}{% else %}no sales in 30 days{% endif %}{% if w.note %} · {{ w.note }}{% endif %}</small></div>
        <div class="r">
          <div>{{ w.median_psf|num if w.median_psf else '—' }}</div>
          <div class="pills"><span class="pill {{ w30.cls }}" title="vs previous 30 days">30d {{ w30.text }}</span><span class="pill {{ w90.cls }}" title="vs 90 days earlier">90d {{ w90.text }}</span></div>
        </div>
      </div>
      {%- endfor %}
      {%- for s in watch_sharjah %}
      <div class="wrow shj"><div><b>{{ s.name }}</b><small>Sharjah · {{ s.developer }} · monthly SRERD totals only</small></div><div class="r"><small>soon</small></div></div>
      {%- endfor %}
      {%- if pulse.rising %}
      <div class="rising" aria-label="Rising fastest"><span style="background:none;padding-left:0">Rising fastest, ready homes, 90d:</span>{% for r in pulse.rising %}<span>{{ r.area }} <b>▲ {{ r.d90 }}%</b></span>{% endfor %}</div>
      {%- endif %}
      <p class="foot">Rising fastest uses ready (resale) homes only, so new launches don't distort it. Medians can still move when a different mix of projects sells. "n/a" means fewer than {{ settings.pulse.min_sample }} home sales in a window. 30d compares with the previous 30 days; 90d with the same 30 days three months earlier. Source: DLD via data.dubai.</p>
    </div>
  </section>
{%- else %}
  <div class="card"><h2>Market pulse</h2><p class="empty">DLD data isn't available yet. The next run will retry.</p></div>
{%- endif %}

  <section id="next" class="card soon" aria-label="Coming next">
    <h2>Coming next <small>one module at a time</small></h2>
    <ul>
      <li>Market-impact news with "why it matters"</li>
      <li>Morning brief and call talking points (also on Telegram)</li>
      <li>Rent monitor from Ejari contracts, with gross yields</li>
      <li>Project pipeline, Developers and Landmarks</li>
    </ul>
  </section>
</main>
<footer>
  Data: Dubai Land Department open data via data.dubai, under the Dubai Open Data Licence{% if meta.snapshot_time %} (DLD file {{ meta.snapshot_time }}){% endif %}.{% if meta.note %} {{ meta.note }}{% endif %} Every figure is as of the DLD day shown on its card. Forecasts are never shown as fact.<br>
  Built {{ now.strftime('%-d %b %Y, %H:%M') }} Gulf time · AI calls today {{ run.llm_calls }}/{{ run.llm_cap }} (free tier).
</footer>
<script>{{ js|safe }}</script>
</body>
</html>
